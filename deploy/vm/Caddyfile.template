# Managed by universe-config (from deploy/vm/Caddyfile.template in the repo). __DOMAIN__ is filled in by
# `universe-config domain <name>`. Caddy gets and renews the HTTPS certificate on its own.
__DOMAIN__ {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# the API, realtime, uploads and seed media → the app (WebSockets are proxied automatically)
	@app path /api /api/* /uploads/* /seed-media/* /ws
	handle @app {
		reverse_proxy 127.0.0.1:4000
	}

	# the web app's hashed files never change → cache them for a year; a missing one is a 404, never index.html
	handle /assets/* {
		root * /opt/universe/current/client/dist
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# everything else → the web app; unknown paths get index.html (client-side routes), always revalidated
	handle {
		root * /opt/universe/current/client/dist
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
